{
  "name": "raven",
  "version": "0.3.0-beta.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Raven: a file manager that finds, organizes and shrinks your files with AI",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --publish never",
    "dist:win": "electron-vite build && electron-builder --win nsis --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac dmg --publish never"
  },
  "devDependencies": {
    "@fontsource/commit-mono": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "echarts": "^6.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "fzf": "^0.5.2",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sigma": "3.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  },
  "author": {
    "name": "HarshF40",
    "email": "harshgaonkar57@gmail.com"
  },
  "homepage": "https://github.com/9u3u3/Raven",
  "build": {
    "appId": "dev.raven.files",
    "productName": "Raven",
    "artifactName": "Raven-${version}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-res"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "../core/dist/raven-core",
        "to": "raven-core",
        "filter": [
          "**/*"
        ]
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build-res/icon.png",
      "synopsis": "A file manager that finds, organizes and shrinks your files",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build-res/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build-res/icon.png"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/9u3u3/Raven.git"
  },
  "desktopName": "raven.desktop",
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/inter": "5.3.0"
  }
}
